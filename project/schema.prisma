datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  isAdmin     Boolean      @default(false) @map("is_admin")
  createdAt   DateTime     @default(now()) @map("created_at")
  chats       Chat[]
  sessions    Session[]
  tickets     Ticket[]
  feedback    Feedback[]
  escalations Escalation[]

  @@map("users")
}

model Chat {
  id          String                @id
  userId      String?               @map("user_id")
  title       String?
  createdAt   DateTime              @default(now()) @map("created_at")
  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  sessions    Session[]
  tickets     Ticket[]
  feedback    Feedback[]
  escalations Escalation[]
  safetyReports SafetyReport[]
  agentLogs   AgentLog[]
  summaries   ConversationSummary[]

  @@map("chats")
}

model Message {
  id            String         @id @default(uuid())
  chatId        String         @map("chat_id")
  role          String
  content       String
  metadata      Json?
  timestamp     DateTime       @default(now())
  chat          Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  safetyReports SafetyReport[]

  @@map("messages")
}

model Session {
  id         String   @id @map("id") // Maps to thread_id
  userId     String?  @map("user_id")
  chatId     String?  @map("chat_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastActive DateTime @default(now()) @map("last_active")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat       Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  chatId    String   @map("chat_id")
  rating    Int
  comment   String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Ticket {
  id            Int      @id @default(autoincrement())
  userId        String?  @map("user_id")
  chatId        String?  @map("chat_id")
  issue         String
  status        String   @default("open")
  customerEmail String   @map("customer_email")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Escalation {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  chatId    String   @map("chat_id")
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("escalations")
}

model SafetyReport {
  id         String   @id @default(uuid())
  chatId     String   @map("chat_id")
  messageId  String?  @map("message_id")
  approved   Boolean
  confidence Float
  issues     Json?
  timestamp  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("safety_reports")
}

model AgentLog {
  id        String   @id @default(uuid())
  chatId    String?  @map("chat_id")
  threadId  String   @map("thread_id")
  nodeName  String   @map("node_name")
  eventType String   @map("event_type")
  payload   Json?
  timestamp DateTime @default(now())
  traceId   String?  @map("trace_id")
  durationMs Float?  @map("duration_ms")
  chat      Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("agent_logs")
}

model PromptVersion {
  id        String   @id @default(uuid())
  key       String
  version   Int
  content   String
  active    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([key, version])
  @@map("prompt_versions")
}

model ConversationTrace {
  id        String   @id
  chatId    String?  @map("chat_id")
  threadId  String   @map("thread_id")
  tenantId  String?  @map("tenant_id")
  status    String   @default("running")
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  metadata  Json?
  @@index([threadId])
  @@map("conversation_traces")
}

model RetrievalRun {
  id        String   @id @default(uuid())
  traceId   String?  @map("trace_id")
  query     String
  namespace String
  filters   Json?
  provider  String?
  latencyMs Float?   @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("retrieval_runs")
}

model RetrievalResult {
  id           String @id @default(uuid())
  retrievalRunId String @map("retrieval_run_id")
  documentId   String? @map("document_id")
  parentId     String? @map("parent_id")
  vectorScore  Float? @map("vector_score")
  rerankScore  Float? @map("rerank_score")
  originalRank Int? @map("original_rank")
  rank         Int?
  metadata     Json?
  @@map("retrieval_results")
}

model CostUsage {
  id           String   @id @default(uuid())
  traceId      String?  @map("trace_id")
  agentName    String?  @map("agent_name")
  provider     String?
  model        String?
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("cost_usage")
}

model EvaluationDataset {
  id        String @id @default(uuid())
  name      String @unique
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("evaluation_datasets")
}

model EvaluationRun {
  id        String @id @default(uuid())
  datasetId String @map("dataset_id")
  status    String @default("pending")
  metrics   Json?
  baseline  Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("evaluation_runs")
}

model ConversationSummary {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  summary   String
  timestamp DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("conversation_summaries")
}

model Document {
  id         String   @id @default(uuid())
  filename   String   @unique
  chunkCount Int      @default(0) @map("chunk_count")
  status     String   @default("pending")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("documents")
}

model ParentChunk {
  id         String   @id @map("id") // Maps to parent_id
  documentId String?  @map("document_id")
  content    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("parent_chunks")
}


model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  agentName String?  @map("agent_name")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("analytics_events")
}

model AgentMetric {
  id              String   @id @default(uuid())
  agentName       String   @map("agent_name")
  requests        Int      @default(0)
  successes       Int      @default(0)
  failures        Int      @default(0)
  avgExecTimeMs   Float    @default(0) @map("avg_exec_time_ms")
  avgConfidence   Float    @default(0) @map("avg_confidence")
  toolCalls       Int      @default(0) @map("tool_calls")
  ragCalls        Int      @default(0) @map("rag_calls")
  escalations     Int      @default(0)
  recordedAt      DateTime @default(now()) @map("recorded_at")

  @@map("agent_metrics")
}

model SystemMetric {
  id             String   @id @default(uuid())
  cpuPct         Float    @map("cpu_pct")
  memPct         Float    @map("mem_pct")
  diskPct        Float    @map("disk_pct")
  apiLatencyMs   Float    @map("api_latency_ms")
  dbQueryMs      Float    @map("db_query_ms")
  vectorSearchMs Float    @map("vector_search_ms")
  embeddingMs    Float    @map("embedding_ms")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@map("system_metrics")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  userId    String?  @map("user_id")
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("security_events")
}
